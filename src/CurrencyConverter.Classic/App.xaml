<Application
    x:Class="CurrencyConverter.Classic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: App.xaml.cs creates MainWindow through dependency injection. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme colors. ThemeService replaces this dictionary with Themes/Dark.xaml and back. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- Our own reusable styles, templates and converters. -->
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
