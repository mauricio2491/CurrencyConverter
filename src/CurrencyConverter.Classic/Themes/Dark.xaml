<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: same keys as Light.xaml, different colors. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2C2C2C" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A" />

    <!-- Accent (primary button, focus, result amount) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CA0E0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5AAEEA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A8AC8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#6CB8F0" />

    <!-- Inputs and buttons -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#1F3A52" />

    <!-- Errors -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#442726" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#6B3A3A" />

</ResourceDictionary>
