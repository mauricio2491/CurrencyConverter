<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme. Dark.xaml defines exactly the same keys with other colors.
        Styles use these brushes with DynamicResource, so when ThemeService swaps
        this dictionary for Dark.xaml, every control repaints itself.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />

    <!-- Accent (primary button, focus, result amount) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0C3B5E" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0F6CBD" />

    <!-- Inputs and buttons -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#E0EEF9" />

    <!-- Errors -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F1BBBC" />

</ResourceDictionary>
