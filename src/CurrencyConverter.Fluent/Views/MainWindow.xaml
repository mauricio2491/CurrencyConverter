<ui:FluentWindow
    x:Class="CurrencyConverter.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CurrencyConverter.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
    Title="Currency Converter"
    Width="680"
    Height="760"
    MinWidth="520"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 title bar (we extended the content into it). -->
        <ui:TitleBar Grid.Row="0" Title="Currency Converter" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" Margin="32,8,32,32">

                <!-- ===== Header ===== -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Currency Converter" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" Text="Convert between world currencies using official reference rates." />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon DarkTheme24}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Switch between light and dark theme"
                        AutomationProperties.Name="Toggle theme" />
                </Grid>

                <!-- ===== Input card ===== -->
                <ui:Card Padding="24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Amount" />
                        <ui:TextBox
                            PlaceholderText="Enter an amount"
                            Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Amount">
                            <!-- Pressing Enter runs the same command as the Convert button. -->
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConvertCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <TextBlock
                            Style="{StaticResource ValidationTextStyle}"
                            Text="{Binding AmountError}"
                            Visibility="{Binding AmountError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="From" />
                                <ComboBox
                                    ItemsSource="{Binding Currencies}"
                                    SelectedItem="{Binding FromCurrency}"
                                    ItemTemplate="{StaticResource CurrencyItemTemplate}"
                                    TextSearch.TextPath="Code"
                                    AutomationProperties.Name="From currency" />
                            </StackPanel>

                            <ui:Button
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Bottom"
                                Icon="{ui:SymbolIcon ArrowSwap24}"
                                Command="{Binding SwapCurrenciesCommand}"
                                ToolTip="Swap currencies"
                                AutomationProperties.Name="Swap currencies" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="To" />
                                <ComboBox
                                    ItemsSource="{Binding Currencies}"
                                    SelectedItem="{Binding ToCurrency}"
                                    ItemTemplate="{StaticResource CurrencyItemTemplate}"
                                    TextSearch.TextPath="Code"
                                    AutomationProperties.Name="To currency" />
                            </StackPanel>
                        </Grid>

                        <ui:Button
                            Margin="0,24,0,0"
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Content="Convert"
                            Icon="{ui:SymbolIcon ArrowRight24}"
                            Command="{Binding ConvertCommand}" />
                    </StackPanel>
                </ui:Card>

                <!-- ===== Loading ===== -->
                <StackPanel
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:ProgressRing Width="24" Height="24" IsIndeterminate="True" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodySecondaryStyle}"
                        Text="{Binding LoadingMessage}" />
                    <ui:Button
                        Margin="12,0,0,0"
                        Appearance="Transparent"
                        Content="Cancel"
                        Command="{Binding ConvertCancelCommand}"
                        Visibility="{Binding ConvertCommand.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- ===== Result (animated when it appears) ===== -->
                <Border
                    Margin="0,24,0,0"
                    Style="{StaticResource RevealOnShowStyle}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Card Padding="24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding SourceAmountText}" />
                            <TextBlock Style="{StaticResource ResultAmountStyle}" Text="{Binding ConvertedAmountText}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                Style="{StaticResource BodySecondaryStyle}"
                                Text="{Binding RateText}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource CaptionStyle}"
                                Text="{Binding RateDateText}" />
                        </StackPanel>
                    </ui:Card>
                </Border>

                <!-- ===== Error ===== -->
                <Border
                    Margin="0,24,0,0"
                    Style="{StaticResource RevealOnShowStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ui:InfoBar
                            Title="{Binding ErrorTitle}"
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="True"
                            IsClosable="False" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Content="Try again"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            Command="{Binding RetryCommand}" />
                    </StackPanel>
                </Border>

                <!-- ===== Footnote ===== -->
                <TextBlock
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource CaptionStyle}"
                    Text="Rates are updated once a day and are not real-time. Source: Frankfurter (frankfurter.dev)." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
